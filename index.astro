---
const title='Halloumi Empire — V0.1';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#ffe1a0"/><title>{title}</title></head><body>
<main class="app">
<header><div class="heading"><span class="badge">🧀</span><div><small>TON AVENTURE COMMENCE</small><h1>Halloumi Empire</h1></div></div><p>De la petite ferme à l'empire du grill.</p></header>
<div class="wallet"><div><small>TON TRÉSOR</small><div><strong id="coins">0</strong> <span>🪙</span></div></div><span class="rate" id="income">Vente manuelle</span></div>
<section class="world" aria-label="Ton île et tes bâtiments"><div class="sun">☀️</div><div class="cloud cloud-a">☁️</div><div class="cloud cloud-b">☁️</div><div class="hill hill-a"></div><div class="hill hill-b"></div><div class="road"></div><div class="building farm" id="scene-farm"><div class="roof"></div><div class="sprite">🐐</div><span>FERME</span><i>🥛</i></div><div class="building dairy" id="scene-dairy"><div class="roof"></div><div class="sprite">🧀</div><span>ATELIER</span><i>🧀</i></div><div class="building grill" id="scene-grill"><div class="roof"></div><div class="sprite">🔥</div><span>GRILL</span><i>🪙</i></div><div class="island-name"><span>🏝️ TON ÎLE</span><span id="stage">Les débuts</span></div><div class="float" id="float" aria-hidden="true"></div></section>
<div class="mission"><span>🎯 MISSION</span><p id="objective">Fabrique et vends ton premier halloumi.</p></div><div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
<div class="section-title">🏗️ Développe tes bâtiments</div>
<section class="cards" aria-label="Chaîne de production">
<article class="card" id="farm"><div class="card-head"><span class="icon">🐐</span><div><h2>La ferme</h2><small>Produis du lait</small></div><b id="farm-level">NV. 1</b></div><div class="bar"><span>🥛 Lait disponible</span><strong id="milk">0</strong></div><div class="actions"><button class="tap" data-manual="farm">Traire +1 🥛</button><button class="improve" data-upgrade="farm">Améliorer · 12 🪙</button></div><button class="auto" data-auto="farm">⚙️ Automatiser · 40 🪙</button></article>
<article class="card" id="dairy"><div class="card-head"><span class="icon">🧀</span><div><h2>La fromagerie</h2><small>Transforme le lait</small></div><b id="dairy-level">NV. 1</b></div><div class="bar"><span>🧀 Blocs disponibles</span><strong id="halloumi">0</strong></div><div class="actions"><button class="tap" data-manual="dairy">Fabriquer · 1 🥛</button><button class="improve" data-upgrade="dairy">Améliorer · 18 🪙</button></div><button class="auto" data-auto="dairy">⚙️ Automatiser · 80 🪙</button></article>
<article class="card" id="grill"><div class="card-head"><span class="icon">🔥</span><div><h2>Le grill</h2><small>Vends tes créations</small></div><b id="grill-level">NV. 1</b></div><div class="bar"><span>🪙 Prix par bloc</span><strong id="price">8</strong></div><div class="actions"><button class="tap" data-manual="grill">Vendre · +8 🪙</button><button class="improve" data-upgrade="grill">Améliorer · 24 🪙</button></div><button class="auto" data-auto="grill">⚙️ Automatiser · 120 🪙</button></article></section>
<section class="panel"><h2>🏆 Tes exploits</h2><div id="milestones"></div></section><details class="panel info"><summary>À propos de la V0.1</summary><p>Partie enregistrée dans ce navigateur uniquement. Les gains hors ligne sont plafonnés à 4 heures. Pas de synchronisation entre appareils ou domaines.</p><p id="stats"></p><button class="reset" id="reset">Recommencer la partie</button></details>
<footer>Halloumi Empire · Prototype sans publicité</footer>
<nav class="dock" aria-label="Bâtiments"><a href="#farm">🐐<span>Ferme</span></a><a href="#dairy">🧀<span>Atelier</span></a><a href="#grill">🔥<span>Grill</span></a></nav></main><script>import '../scripts/game.js';</script></body></html>
<style>
:global(*){box-sizing:border-box}:global(html){background:#ffedc6;scroll-behavior:smooth}:global(body){margin:0;background:linear-gradient(180deg,#ffe0a1,#fff3d7 550px,#f8e6be);font-family:system-ui,-apple-system,sans-serif;color:#513522}:global(button){font:inherit;cursor:pointer;touch-action:manipulation}:global(button:disabled){opacity:.5;cursor:not-allowed}:global(button:focus-visible),:global(a:focus-visible),:global(summary:focus-visible){outline:3px solid #12658c;outline-offset:2px}.app{max-width:550px;margin:auto;padding:14px 16px 108px}header{padding:6px 3px 12px}.heading{display:flex;align-items:center;gap:11px}.badge{font-size:40px}header small{font-size:10px;font-weight:900;letter-spacing:.12em;color:#ae5d2b}h1{margin:0;font-size:29px;line-height:1.2;letter-spacing:-.05em;color:#763919}header p{margin:8px 0 0;font-size:13px;color:#8d6043}.wallet{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(120deg,#75482b,#3b2a21);border:2px solid #c89660;border-radius:19px;padding:12px 17px;color:#fff9e8;box-shadow:0 5px 0 #b58d5a;margin-bottom:17px;position:sticky;top:7px;z-index:5}.wallet small{font-size:10px;font-weight:800;letter-spacing:.1em;color:#e8c99e}.wallet strong{font-size:29px;color:#ffe079;font-variant-numeric:tabular-nums}.rate{font-size:11px;border-radius:15px;padding:7px 9px;background:#996e40}.world{height:255px;position:relative;overflow:hidden;background:linear-gradient(#79c8f6 0%,#b7e9ff 57%,#81c779 57%,#5b9f53 100%);border:4px solid #fff7d8;border-radius:25px;box-shadow:0 7px 0 #c5955f,0 12px 18px #7c4e2644}.sun{position:absolute;top:13px;right:20px;font-size:39px;filter:drop-shadow(0 0 10px #fff5aa)}.cloud{position:absolute;top:15px;left:35px;font-size:30px;animation:drift 7s ease-in-out infinite alternate}.cloud-b{top:54px;left:54%;font-size:20px;animation-delay:-3s}.hill{position:absolute;bottom:28px;width:90%;height:94px;border-radius:50% 50% 0 0}.hill-a{left:-18%;background:#81ba71}.hill-b{right:-25%;background:#72ae63}.road{position:absolute;bottom:18px;left:0;width:100%;height:38px;background:repeating-linear-gradient(110deg,#c79660 0 25px,#d9a76e 25px 48px)}.building{position:absolute;bottom:55px;width:25%;height:88px;border:3px solid #9e603a;border-radius:8px;background:#ffdea4;display:flex;flex-direction:column;justify-content:center;align-items:center;box-shadow:4px 6px 0 #487646;transform-origin:bottom;transition:transform .2s}.building .roof{position:absolute;top:-23px;left:-5%;width:110%;height:25px;background:#bf6942;clip-path:polygon(50% 0%,100% 100%,0 100%);filter:drop-shadow(0 -2px #fff1d7)}.building .sprite{font-size:34px;line-height:1.3;z-index:1}.building span{font-size:10px;font-weight:950;z-index:1}.building i{position:absolute;top:-45px;font-size:23px;opacity:0;pointer-events:none;font-style:normal}.building.active i{animation:up 1s ease-out}.building.pop{animation:pop .55s ease}.building.automated{box-shadow:4px 6px 0 #487646,0 0 0 4px #ffe270}.farm{left:5%}.dairy{left:38%;background:#fff7cf}.grill{right:5%;background:#ffd09a}.island-name{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;background:#406332;color:white;padding:6px 11px;font-weight:850;font-size:10px}.float{position:absolute;left:45%;top:45px;color:#fff;font-size:22px;font-weight:950;text-shadow:1px 2px #654024;opacity:0;pointer-events:none}.float.fly{animation:up 1s ease-out}.mission,.panel{border:2px solid #e9bb67;background:#fff9de;border-radius:17px;margin-top:20px;padding:14px;box-shadow:0 4px 0 #dfbd80}.mission span{font-size:11px;font-weight:950;letter-spacing:.08em;color:#b16426}.mission p{font-size:14px;font-weight:750;margin:7px 0 1px}.notice{background:#dff2d6;border:2px solid #a1c985;padding:11px;border-radius:12px;margin-top:15px;font-size:13px;font-weight:700}.notice[hidden]{display:none}.section-title{font-size:18px;font-weight:950;margin:24px 3px 15px}.cards{display:grid;gap:16px}.card{background:#fffaf0;border:2px solid #d89c61;box-shadow:0 5px 0 #b77b4e;border-radius:19px;padding:14px;scroll-margin-top:83px}.card-head{display:flex;align-items:center;gap:9px}.icon{font-size:25px;background:#fae6b4;padding:7px;border-radius:12px}.card-head div{flex:1}.card h2,.panel h2{font-size:16px;margin:0}.card-head small{font-size:11px;color:#8c7055}.card-head b{font-size:11px;color:#9b5c27;background:#f9e8c3;padding:6px;border-radius:8px}.bar{display:flex;justify-content:space-between;background:#f4eddf;padding:9px;border-radius:9px;font-size:12px;margin:12px 0}.bar strong{font-size:16px;font-variant-numeric:tabular-nums}.actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}.card button{min-height:47px;border-radius:11px;font-size:12px;font-weight:800;padding:7px}.tap{background:linear-gradient(#fca049,#da702c);border:2px solid #ac5327;color:white;box-shadow:0 3px 0 #a4522d}.improve{background:#ffe7aa;border:2px solid #dbb373;box-shadow:0 3px 0 #bb965f}.auto{width:100%;margin-top:10px;background:#e4f1d3;border:2px solid #a5c389;color:#426d35}.tap:active,.improve:active,.auto:active{transform:translateY(2px);box-shadow:none}.done{background:#e5f4d9!important;color:#426c30}.panel{margin-top:20px}.milestone{font-size:12px;background:#f7ebcf;padding:8px;border-radius:9px;margin-top:7px}.milestone.complete{background:#e4f4d7;color:#416b32}.info summary{font-weight:850;cursor:pointer}.info p{font-size:12px;line-height:1.5}.reset{background:#fff1e7;border:1px solid #bf765b;color:#943a26;border-radius:9px;padding:10px}footer{text-align:center;font-size:11px;color:#8c745c;margin-top:24px}.dock{position:fixed;z-index:10;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,550px);display:flex;justify-content:space-around;padding:9px 5px max(9px,env(safe-area-inset-bottom));background:#fff7df;border:3px solid #dbaa64;border-bottom:0;border-radius:19px 19px 0 0;box-shadow:0 -5px 18px #70442433}.dock a{color:#714723;text-align:center;text-decoration:none;font-size:23px;min-width:60px;line-height:1.1}.dock span{display:block;font-size:10px;font-weight:850}@keyframes pop{50%{transform:scale(1.14) rotate(-3deg)}}@keyframes up{0%{opacity:1;transform:translateY(15px)}75%{opacity:1}100%{opacity:0;transform:translateY(-55px)}}@keyframes drift{to{transform:translateX(25px)}}@media(max-width:360px){.app{padding-left:10px;padding-right:10px}.actions{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.cloud,.building.pop,.building.active i,.float.fly{animation:none}}
</style>
