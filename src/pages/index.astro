---
const base = import.meta.env.BASE_URL;
const halloumi = `${base}icons/halloumi.svg`;
const grill = `${base}icons/grill.svg`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no" />
  <meta name="theme-color" content="#ffebbb" />
  <title>Halloumi Empire — V0.3</title>
</head>
<body>
<main class="app">
  <header class="header">
    <div><small>HALLOUMI EMPIRE · V0.3</small><h1 id="screen-title">Mon île</h1></div>
    <div class="wallet" aria-label="Pièces"><strong id="coins">0</strong><span>●</span></div>
  </header>
  <div class="objective"><span>🎯</span><span id="objective">Fabrique ton premier halloumi</span></div>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

  <section class="screen island" id="screen-island" aria-label="Ton domaine de halloumi">
    <div class="map" aria-label="Carte de production">
      <div class="water"></div><div class="road r1"></div><div class="road r2"></div><div class="road r3"></div>
      <div class="tree t1"></div><div class="tree t2"></div><div class="tree t3"></div><div class="tree t4"></div><div class="tree t5"></div>
      <div class="cloud c1"></div><div class="cloud c2"></div>

      <article class="building-card farm-card" data-open="farm" role="button" tabindex="0" aria-label="Ouvrir la ferme et ses améliorations">
        <div class="building-art farm-art"><div class="farm-roof"></div><span class="goat">🐐</span><span class="mini-shed"></span></div>
        <div class="building-label"><strong>Ferme</strong><small id="farm-level">Niv. 1</small></div>
        <span class="tap-hint" id="farm-hint">TOUCHER POUR GÉRER</span>
        <span class="worker" id="farm-worker" hidden>👩‍🌾</span>
      </article>

      <div class="flow-line flow-milk"><span>────────▶</span><span class="moving milk-dot" id="milk-cargo">🥛</span></div>

      <article class="building-card dairy-card" data-open="dairy" role="button" tabindex="0" aria-label="Ouvrir l’atelier et ses améliorations">
        <div class="building-art dairy-art"><div class="factory-roof"></div><img src={halloumi} alt="Bloc de halloumi" /></div>
        <div class="building-label"><strong>Atelier</strong><small id="dairy-level">Niv. 1</small></div>
        <span class="tap-hint" id="dairy-hint">TOUCHER POUR GÉRER</span>
        <span class="worker" id="dairy-worker" hidden>👨‍🍳</span>
      </article>

      <div class="flow-line flow-cheese"><span>────────▶</span><img class="moving cheese-dot" id="halloumi-cargo" src={halloumi} alt="" /></div>

      <article class="building-card grill-card" data-open="grill" role="button" tabindex="0" aria-label="Ouvrir le grill et ses améliorations">
        <div class="building-art grill-art"><div class="grill-awning"></div><img src={grill} alt="Grill de halloumi" /></div>
        <div class="building-label"><strong>Grill</strong><small id="grill-level">Niv. 1</small></div>
        <span class="tap-hint" id="grill-hint">TOUCHER POUR GÉRER</span>
        <span class="worker" id="grill-worker" hidden>🧑‍🍳</span>
      </article>

      <div id="burst" class="burst" aria-hidden="true"></div>
      <div class="map-footer"><span>🏝️ ÎLE DE HALLOUMI</span><span id="map-status">La ferme attend son premier client</span></div>
    </div>

    <div class="quick-actions" aria-label="Actions rapides">
      <button class="quick-action" data-manual="farm"><span>🐐</span><b>Traire</b><small id="farm-quick">+1 lait</small></button>
      <button class="quick-action" data-manual="dairy"><img src={halloumi} alt="" /><b>Fabriquer</b><small id="dairy-quick">1 lait</small></button>
      <button class="quick-action" data-manual="grill"><img src={grill} alt="" /><b>Vendre</b><small id="grill-quick">+8 pièces</small></button>
    </div>

    <div class="resources"><span>🥛 <b id="milk">0</b></span><span><img src={halloumi} alt="" /> <b id="halloumi">0</b></span><span>🪙 <b id="income">0/min</b></span></div>
  </section>

  <section class="screen secondary" id="screen-achievements" hidden><h2>🏆 Exploits</h2><p>Les étapes de ton petit empire.</p><div id="milestones"></div></section>
  <section class="screen secondary" id="screen-empire" hidden><h2>📈 Empire</h2><p>Observe la production et choisis ton prochain investissement.</p><div id="bottleneck" class="tip"></div><div class="record"><span>Blocs vendus</span><b id="sold">0</b></div><div class="record"><span>Prix par bloc</span><b id="price">8</b></div><div class="record"><span>Actions manuelles</span><b id="taps">0</b></div><p class="disclaimer">Sauvegarde sur ce navigateur. Gains hors ligne plafonnés à 4 heures.</p><button id="reset" class="reset">Recommencer la partie</button></section>

  <nav class="tabs" aria-label="Navigation principale"><button data-tab="achievements">★<span>Exploits</span></button><button data-tab="island" class="selected" aria-current="page">⌂<span>Île</span></button><button data-tab="empire">▥<span>Empire</span></button></nav>

  <div class="overlay" id="station-overlay" hidden><button class="scrim" id="close-scrim" aria-label="Fermer le panneau"></button><section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title"><div class="sheet-head"><div><small>BÂTIMENT SÉLECTIONNÉ</small><h2 id="sheet-title">Ferme</h2></div><button id="close-sheet" class="close" aria-label="Fermer">✕</button></div><p id="sheet-status" class="sheet-status"></p><div class="sheet-stat"><span>Niveau actuel</span><strong id="sheet-level">1</strong></div><div class="sheet-stat"><span>Rendement</span><strong id="sheet-output">1 par cycle</strong></div><button id="upgrade" class="buy">Améliorer</button><small id="upgrade-preview" class="preview"></small><button id="automate" class="hire">Recruter un employé</button></section></div>

  <div class="overlay" id="offline-overlay" hidden><div class="scrim static-scrim"></div><section class="sheet offline-sheet" role="dialog" aria-modal="true" aria-labelledby="offline-title"><span class="offline-icon">🪙</span><h2 id="offline-title">Ton empire a travaillé !</h2><p id="offline-detail"></p><strong id="offline-coins">+0 pièces</strong><button id="collect" class="buy">Encaisser</button></section></div>
</main><script>import '../scripts/game.js';</script></body></html>
<style>
:global(*){box-sizing:border-box;-webkit-tap-highlight-color:transparent}:global([hidden]){display:none!important}:global(html){touch-action:manipulation}:global(body){margin:0;background:#ffebba;color:#533820;font-family:system-ui,-apple-system,sans-serif;overscroll-behavior:none}:global(button){font:inherit;cursor:pointer;touch-action:manipulation}:global(button:disabled){opacity:.46;cursor:not-allowed}:global(button:focus-visible),:global([role="button"]:focus-visible){outline:3px solid #126d84;outline-offset:2px}.app{width:min(100%,520px);height:100vh;height:100dvh;min-height:520px;display:flex;flex-direction:column;margin:auto;position:relative;overflow:hidden;background:#fff0cf}.header{flex:none;min-height:75px;padding:13px 17px 8px;display:flex;justify-content:space-between;align-items:center}.header small{color:#b57536;font-size:10px;font-weight:900;letter-spacing:.11em}.header h1{margin:3px 0 0;font-size:25px;color:#703b23}.wallet{background:#603c29;border:2px solid #bd8246;border-radius:30px;padding:7px 11px;color:#fff0b8;display:flex;gap:7px;align-items:center;box-shadow:0 3px #bb8952}.wallet span{color:#ffd354}.wallet strong{font-variant-numeric:tabular-nums}.objective{flex:none;margin:0 14px 7px;background:#fff9df;border:2px solid #e2b770;padding:8px 10px;border-radius:12px;font-size:12px;font-weight:750;display:flex;gap:9px;align-items:center;min-height:39px}.toast{position:absolute;top:110px;left:30px;right:30px;z-index:15;padding:10px;background:#e3f6d7;border:2px solid #95c57d;border-radius:12px;text-align:center;font-size:13px;font-weight:800}.screen{flex:1;min-height:0}.island{display:flex;min-height:0;flex-direction:column;padding:0 11px 7px;gap:7px}.map{position:relative;flex:1;min-height:0;overflow:hidden;border:3px solid #fffbe8;border-radius:23px;background:linear-gradient(140deg,#7fb96a 0 49%,#a8d183 49% 100%);box-shadow:0 4px #c69b64}.water{position:absolute;inset:-20% -8% 53% 46%;background:#75c7e6;border-radius:50%;border:8px solid #a8e0ef}.road{position:absolute;background:#4b4a51;border:3px solid #d5cfbf}.r1{width:140%;height:30px;left:-25%;top:41%;transform:rotate(-18deg)}.r2{width:31px;height:98%;left:47%;top:-5%;transform:rotate(15deg)}.r3{width:72%;height:25px;right:-17%;bottom:22%;transform:rotate(23deg)}.tree{position:absolute;width:17px;height:24px;background:#3d8d50;border-radius:50% 50% 42% 42%;box-shadow:0 8px 0 -4px #885c35}.t1{top:7%;left:10%}.t2{top:26%;right:8%}.t3{top:65%;left:8%}.t4{bottom:8%;left:36%}.t5{bottom:12%;right:9%}.cloud{position:absolute;width:48px;height:13px;background:#fff9e9;border-radius:20px;opacity:.8}.cloud:before{content:'';position:absolute;bottom:4px;left:11px;width:26px;height:20px;border-radius:50%;background:inherit}.c1{top:5%;right:15%}.c2{top:35%;left:2%;transform:scale(.65)}.building-card{position:absolute;width:42%;height:31%;padding:6px;border:2px solid #855b38;border-radius:16px;background:#fff5d9;box-shadow:0 5px 0 #5e8755,0 7px 10px #2a493444;display:flex;align-items:center;gap:6px;z-index:3}.building-card:active{transform:translateY(2px);box-shadow:0 3px 0 #5e8755}.farm-card{left:6%;top:9%}.dairy-card{right:5%;top:35%;background:#fff9e7}.grill-card{left:8%;bottom:12%;background:#ffe4b0}.building-art{position:relative;display:grid;place-items:center;flex:none;width:clamp(50px,13vw,73px);height:clamp(50px,13vw,73px);background:#f4d58e;border:2px solid #ad7844;border-radius:12px}.building-art img{width:94%;height:94%;object-fit:contain}.goat{font-size:clamp(32px,8vw,47px)}.farm-roof,.factory-roof,.grill-awning{position:absolute;top:-11px;left:-4%;width:108%;height:14px;background:#c66f42;clip-path:polygon(50% 0,100% 100%,0 100%)}.factory-roof{background:#688db4}.grill-awning{background:repeating-linear-gradient(90deg,#df6947 0 7px,#fff3c9 7px 14px);clip-path:none;border-radius:4px}.mini-shed{position:absolute;right:-8px;bottom:0;width:13px;height:16px;background:#bd7140;border:2px solid #845134}.building-label{min-width:0;flex:1}.building-label strong{display:block;font-size:clamp(14px,3.2vw,18px)}.building-label small{font-size:10px;color:#865e36}.tap-hint{position:absolute;bottom:-12px;left:50%;transform:translateX(-50%);z-index:4;white-space:nowrap;background:#6a482d;color:#fff5d5;border:2px solid #fff5d5;border-radius:9px;padding:3px 5px;font-size:7px;font-weight:950;letter-spacing:.04em}.worker{position:absolute;right:-12px;top:-10px;background:#fff5db;border:2px solid #79aa65;border-radius:50%;font-size:17px;padding:2px;z-index:5}.flow-line{position:absolute;z-index:2;color:#755333;font-size:13px;font-weight:950;letter-spacing:1px}.flow-milk{top:32%;left:36%;transform:rotate(24deg)}.flow-cheese{top:64%;left:42%;transform:rotate(124deg)}.moving{position:absolute;left:9%;top:-8px;width:26px;height:26px;object-fit:contain;opacity:0}.moving.travel{animation:travel 1.05s linear}.map-footer{position:absolute;z-index:6;bottom:0;left:0;right:0;height:27px;padding:6px 9px;background:#3e663a;color:#fff;display:flex;justify-content:space-between;font-size:9px;font-weight:800}.burst{position:absolute;z-index:8;left:48%;top:48%;color:#fff;font-size:21px;font-weight:950;text-shadow:2px 2px #694629;opacity:0;pointer-events:none}.burst.fly{animation:burst .95s ease-out}.quick-actions{flex:none;display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.quick-action{min-height:59px;border:2px solid #c08042;border-radius:13px;background:#fff8df;box-shadow:0 3px #d1a464;display:grid;grid-template-columns:31px 1fr;grid-template-rows:1fr 1fr;align-items:center;text-align:left;padding:5px;color:#593a20}.quick-action:active{transform:translateY(2px);box-shadow:0 1px #d1a464}.quick-action>span,.quick-action>img{grid-row:1/3;width:29px;height:29px;object-fit:contain;text-align:center;font-size:27px}.quick-action b{font-size:11px}.quick-action small{font-size:9px;color:#8c633a}.resources{flex:none;height:28px;border-radius:10px;background:#426738;color:#fff;display:flex;justify-content:space-around;align-items:center;font-size:11px}.resources span{display:flex;align-items:center;gap:3px}.resources img{width:20px;height:20px}.resources b{font-variant-numeric:tabular-nums}.secondary{overflow-y:auto;padding:10px 17px 18px}.secondary h2{margin:4px 0;font-size:21px}.secondary>p{font-size:12px;color:#82684f}.achievement,.tip,.record{border:2px solid #ddba85;background:#fff9e9;border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 3px #dec394}.achievement.complete{background:#e8f5db;border-color:#a2cb83}.tip{font-size:13px;font-weight:800}.record{display:flex;justify-content:space-between;font-size:13px}.disclaimer{margin-top:20px;line-height:1.5}.reset{padding:10px;background:#fff2e5;color:#963e2e;border:1px solid #c37e66;border-radius:10px}.tabs{flex:none;z-index:10;min-height:67px;padding:5px 3px max(8px,env(safe-area-inset-bottom));background:#fff9e8;border-top:2px solid #dcb980;display:grid;grid-template-columns:repeat(3,1fr)}.tabs button{border:0;background:transparent;border-radius:12px;min-height:50px;color:#987a58;font-size:23px;font-weight:850}.tabs button span{display:block;font-size:10px}.tabs .selected{background:#f1d9af;color:#633821}.overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:flex-end}.scrim{position:absolute;inset:0;border:0;background:#251d19aa;width:100%;height:100%;border-radius:0}.sheet{position:relative;width:100%;padding:16px 19px max(22px,env(safe-area-inset-bottom));background:#fff5d9;border:3px solid #d1a069;border-bottom:0;border-radius:23px 23px 0 0;box-shadow:0 -6px 24px #2a21144d}.sheet-head{display:flex;justify-content:space-between;align-items:center}.sheet-head small{font-size:10px;font-weight:900;color:#a97335}.sheet-head h2{margin:1px 0 0;font-size:23px}.close{border:0;background:#f4dfb8;border-radius:9px;padding:7px 12px}.sheet-status{font-size:12px;color:#775a3a;min-height:18px}.sheet-stat{display:flex;justify-content:space-between;background:#fae8bf;padding:9px;margin:6px 0;border-radius:9px;font-size:13px}.buy,.hire{width:100%;min-height:46px;border:2px solid #ac5e2b;border-radius:11px;background:#e47a33;color:white;font-size:13px;font-weight:850;margin-top:9px}.hire{background:#5c9c56;border-color:#387639}.preview{display:block;color:#805f37;font-size:11px;margin-top:5px}.offline-sheet{text-align:center;padding-top:24px}.offline-icon{font-size:40px}.offline-sheet h2{margin:6px 0}.offline-sheet p{font-size:13px}.offline-sheet strong{display:block;font-size:29px;color:#9a601d;margin:12px}.offline-sheet .buy{margin-top:14px}@keyframes travel{0%{opacity:0;left:9%}15%{opacity:1}85%{opacity:1}100%{opacity:0;left:72%}}@keyframes burst{0%{opacity:1;transform:translateY(18px)}75%{opacity:1}100%{opacity:0;transform:translateY(-45px)}}@media(max-height:650px){.header{min-height:57px;padding-top:6px}.header h1{font-size:20px}.objective{min-height:32px;margin-bottom:4px}.island{gap:4px}.building-card{height:29%;padding:3px}.building-art{width:43px;height:43px}.goat{font-size:29px}.quick-action{min-height:49px}.tap-hint{font-size:6px}.tabs{min-height:56px}}@media(max-width:350px){.building-card{width:45%}.building-label strong{font-size:13px}.quick-action{grid-template-columns:26px 1fr;padding:3px}.quick-action>span,.quick-action>img{width:25px;height:25px;font-size:23px}.quick-action b{font-size:10px}}@media(prefers-reduced-motion:reduce){.moving.travel,.burst.fly{animation:none}}
</style>
