---
const base = import.meta.env.BASE_URL;
const halloumi = `${base}icons/halloumi.svg`;
const grill = `${base}icons/grill.svg`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ffebbb" />
  <title>Halloumi Empire — V0.3</title>
</head>
<body>
<main class="app">
  <header class="header">
    <div><small>HALLOUMI EMPIRE · V0.3</small><h1 id="screen-title">Mon île</h1></div>
    <div class="wallet"><strong id="coins">0</strong><span>●</span></div>
  </header>
  <div class="objective"><span>🎯</span><span id="objective">Fabrique ton premier halloumi</span></div>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

  <section class="screen island" id="screen-island" aria-label="Chaîne de production">
    <div class="sky"><span class="sun"></span><span class="cloud"></span></div>
    <div class="flow">
      <div class="station station-farm" data-open="farm" role="button" tabindex="0" aria-label="Ouvrir la ferme">
        <div class="building"><span class="roof"></span><span class="art goat">🐐</span><span class="worker" id="farm-worker" hidden>👩‍🌾</span></div>
        <div class="station-info"><strong>Ferme</strong><small id="farm-level">Niveau 1</small><div class="meter"><i id="farm-meter"></i></div></div>
        <button class="manual" data-manual="farm">Traire</button>
      </div>
      <div class="route"><span class="track">───────▶</span><span class="cargo" id="milk-cargo">🥛</span><span class="route-label">lait</span></div>
      <div class="station station-dairy" data-open="dairy" role="button" tabindex="0" aria-label="Ouvrir l’atelier">
        <div class="building"><span class="roof"></span><img class="art" src={halloumi} alt="Bloc de halloumi" /><span class="worker" id="dairy-worker" hidden>👨‍🍳</span></div>
        <div class="station-info"><strong>Atelier</strong><small id="dairy-level">Niveau 1</small><div class="meter"><i id="dairy-meter"></i></div></div>
        <button class="manual" data-manual="dairy">Fabriquer</button>
      </div>
      <div class="route route-down"><span class="track">───────▶</span><img class="cargo" id="halloumi-cargo" src={halloumi} alt="" /><span class="route-label">halloumi</span></div>
      <div class="station station-grill" data-open="grill" role="button" tabindex="0" aria-label="Ouvrir le grill">
        <div class="building"><span class="roof"></span><img class="art" src={grill} alt="Grill à halloumi" /><span class="worker" id="grill-worker" hidden>🧑‍🍳</span></div>
        <div class="station-info"><strong>Grill</strong><small id="grill-level">Niveau 1</small><div class="meter"><i id="grill-meter"></i></div></div>
        <button class="manual" data-manual="grill">Vendre</button>
      </div>
    </div>
    <div class="bottom-status"><span>🥛 <b id="milk">0</b></span><span><img src={halloumi} alt="Halloumi" /> <b id="halloumi">0</b></span><span>🪙 <b id="income">0/min</b></span></div>
    <div id="burst" class="burst" aria-hidden="true"></div>
  </section>

  <section class="screen secondary" id="screen-achievements" hidden>
    <h2>🏆 Exploits</h2><p>Les étapes de ton petit empire.</p><div id="milestones"></div>
  </section>
  <section class="screen secondary" id="screen-empire" hidden>
    <h2>📈 Empire</h2><p>Surveille la production et choisis le prochain investissement.</p>
    <div id="bottleneck" class="tip"></div>
    <div class="record"><span>Blocs vendus</span><b id="sold">0</b></div>
    <div class="record"><span>Prix par bloc</span><b id="price">8</b></div>
    <div class="record"><span>Actions manuelles</span><b id="taps">0</b></div>
    <p class="disclaimer">Sauvegarde sur ce navigateur. Gains hors ligne plafonnés à 4 heures.</p>
    <button id="reset" class="reset">Recommencer la partie</button>
  </section>

  <nav class="tabs" aria-label="Navigation principale">
    <button data-tab="achievements">★<span>Exploits</span></button>
    <button data-tab="island" class="selected" aria-current="page">⌂<span>Île</span></button>
    <button data-tab="empire">▥<span>Empire</span></button>
  </nav>

  <div class="overlay" id="station-overlay" hidden>
    <button class="scrim" id="close-scrim" aria-label="Fermer le panneau"></button>
    <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
      <div class="sheet-head"><div><small>BÂTIMENT</small><h2 id="sheet-title">Ferme</h2></div><button id="close-sheet" class="close" aria-label="Fermer">✕</button></div>
      <p id="sheet-status" class="sheet-status"></p>
      <div class="sheet-stat"><span>Niveau actuel</span><strong id="sheet-level">1</strong></div>
      <div class="sheet-stat"><span>Rendement</span><strong id="sheet-output">1 par cycle</strong></div>
      <button id="upgrade" class="buy">Améliorer</button>
      <small id="upgrade-preview" class="preview"></small>
      <button id="automate" class="hire">Recruter un employé</button>
    </section>
  </div>

  <div class="overlay" id="offline-overlay" hidden>
    <div class="scrim static-scrim"></div>
    <section class="sheet offline-sheet" role="dialog" aria-modal="true" aria-labelledby="offline-title">
      <span class="offline-icon">🪙</span><h2 id="offline-title">Ton empire a travaillé !</h2>
      <p id="offline-detail"></p><strong id="offline-coins">+0 pièces</strong>
      <button id="collect" class="buy">Encaisser</button>
    </section>
  </div>
</main>
<script>import '../scripts/game.js';</script>
</body></html>
<style>
:global(*){box-sizing:border-box}:global([hidden]){display:none!important}:global(body){margin:0;background:#ffe8b4;color:#533820;font-family:system-ui,-apple-system,sans-serif}:global(button){font:inherit;cursor:pointer;touch-action:manipulation}:global(button:disabled){opacity:.46;cursor:not-allowed}:global(button:focus-visible),:global([role="button"]:focus-visible){outline:3px solid #126d84;outline-offset:2px}
.app{width:min(100%,520px);height:100vh;height:100dvh;min-height:520px;display:flex;flex-direction:column;margin:auto;position:relative;overflow:hidden;background:#fff0cf}.header{flex:none;min-height:75px;padding:13px 17px 8px;display:flex;justify-content:space-between;align-items:center}.header small{color:#b57536;font-size:10px;font-weight:900;letter-spacing:.11em}.header h1{margin:3px 0 0;font-size:25px;color:#703b23}.wallet{background:#603c29;border:2px solid #bd8246;border-radius:30px;padding:7px 11px;color:#fff0b8;display:flex;gap:7px;align-items:center;box-shadow:0 3px #bb8952}.wallet span{color:#ffd354}.wallet strong{font-variant-numeric:tabular-nums}.objective{flex:none;margin:0 14px 7px;background:#fff9df;border:2px solid #e2b770;padding:8px 10px;border-radius:12px;font-size:12px;font-weight:750;display:flex;gap:9px;align-items:center;min-height:39px}.toast{position:absolute;top:110px;left:30px;right:30px;z-index:15;padding:10px;background:#e3f6d7;border:2px solid #95c57d;border-radius:12px;text-align:center;font-size:13px;font-weight:800}.screen{flex:1;min-height:0}.island{position:relative;overflow:hidden;margin:0 11px 7px;border:3px solid #fffbe8;border-radius:23px;background:linear-gradient(#8dd0f1 0 38%,#b7dc96 38%,#6dab70 100%);box-shadow:0 4px #c69b64}.sky,.flow{position:absolute;inset:0}.sky{pointer-events:none}.sun{position:absolute;right:22px;top:13px;width:37px;height:37px;border-radius:50%;background:#ffdd6d;border:4px solid #fff0a8}.cloud{position:absolute;top:34px;left:27px;width:50px;height:15px;border-radius:20px;background:#fff8ed}.cloud:before{content:'';position:absolute;bottom:5px;left:12px;width:28px;height:22px;border-radius:50%;background:inherit}.flow{padding:32px 14px 46px;display:flex;flex-direction:column;justify-content:space-between;gap:4px}.station{position:relative;display:flex;align-items:center;gap:8px;padding:5px 7px;min-height:0;flex:1;background:#fff7dfef;border:2px solid #a77b4e;border-radius:17px;box-shadow:0 4px #73975e}.station-dairy{margin-left:25px}.station-grill{margin-right:17px}.building{position:relative;flex:none;width:clamp(46px,9vh,67px);height:clamp(45px,8.8vh,65px);display:grid;place-items:center;background:#f5da9a;border:2px solid #a77041;border-radius:12px}.roof{position:absolute;top:-13px;left:-4%;width:108%;height:15px;background:#c77a46;clip-path:polygon(50% 0,100% 100%,0 100%)}.art{width:95%;height:95%;object-fit:contain}.goat{display:grid;place-items:center;font-size:clamp(30px,6vh,45px)}.worker{position:absolute;right:-13px;bottom:-9px;background:#fff5db;border:2px solid #8bb970;border-radius:50%;font-size:17px;padding:2px}.station-info{min-width:0;flex:1}.station-info strong{display:block;font-size:clamp(14px,3vh,19px)}.station-info small{font-size:10px;color:#865e36}.meter{height:6px;margin-top:5px;background:#e1d3b8;border-radius:10px;overflow:hidden}.meter i{height:100%;width:0;display:block;background:#75b25a;border-radius:10px;transition:width .2s}.manual{min-height:43px;min-width:82px;max-width:93px;border:2px solid #ac5c28;border-radius:12px;background:linear-gradient(#ff9c46,#d96c28);box-shadow:0 3px #ad5929;color:#fff;font-size:12px;font-weight:900;padding:5px}.manual:active{transform:translateY(2px);box-shadow:none}.route{height:21px;flex:none;display:flex;justify-content:center;align-items:center;position:relative;color:#755333;font-size:13px;font-weight:850}.route-down{transform:scaleX(-1)}.track{letter-spacing:2px}.route-label{font-size:9px;margin-left:14px}.route-down .route-label{transform:scaleX(-1)}.cargo{position:absolute;left:22%;top:-7px;width:27px;height:27px;object-fit:contain;opacity:0;pointer-events:none}.cargo.travel{animation:travel 1.15s linear}.route-down .cargo{transform:scaleX(-1)}.bottom-status{position:absolute;bottom:0;left:0;right:0;height:34px;background:#3e663a;color:#fff;display:flex;justify-content:space-around;align-items:center;font-size:12px}.bottom-status span{display:flex;align-items:center;gap:4px}.bottom-status img{width:23px;height:23px}.bottom-status b{font-variant-numeric:tabular-nums}.burst{position:absolute;left:53%;top:53%;color:#fff;font-size:21px;font-weight:950;text-shadow:2px 2px #694629;opacity:0;pointer-events:none}.burst.fly{animation:burst .95s ease-out}.secondary{overflow-y:auto;padding:10px 17px 18px}.secondary h2{margin:4px 0;font-size:21px}.secondary>p{font-size:12px;color:#82684f}.achievement,.tip,.record{border:2px solid #ddba85;background:#fff9e9;border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 3px #dec394}.achievement.complete{background:#e8f5db;border-color:#a2cb83}.tip{font-size:13px;font-weight:800}.record{display:flex;justify-content:space-between;font-size:13px}.disclaimer{margin-top:20px;line-height:1.5}.reset{padding:10px;background:#fff2e5;color:#963e2e;border:1px solid #c37e66;border-radius:10px}.tabs{flex:none;z-index:5;min-height:67px;padding:5px 3px max(8px,env(safe-area-inset-bottom));background:#fff9e8;border-top:2px solid #dcb980;display:grid;grid-template-columns:repeat(3,1fr)}.tabs button{border:0;background:transparent;border-radius:12px;min-height:50px;color:#987a58;font-size:23px;font-weight:850}.tabs button span{display:block;font-size:10px}.tabs .selected{background:#f1d9af;color:#633821}.overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:flex-end}.scrim{position:absolute;inset:0;border:0;background:#251d19aa;width:100%;height:100%;border-radius:0}.sheet{position:relative;width:100%;padding:16px 19px max(22px,env(safe-area-inset-bottom));background:#fff5d9;border:3px solid #d1a069;border-bottom:0;border-radius:23px 23px 0 0;box-shadow:0 -6px 24px #2a21144d}.sheet-head{display:flex;justify-content:space-between;align-items:center}.sheet-head small{font-size:10px;font-weight:900;color:#a97335}.sheet-head h2{margin:1px 0 0;font-size:23px}.close{border:0;background:#f4dfb8;border-radius:9px;padding:7px 12px}.sheet-status{font-size:12px;color:#775a3a;min-height:18px}.sheet-stat{display:flex;justify-content:space-between;background:#fae8bf;padding:9px;margin:6px 0;border-radius:9px;font-size:13px}.buy,.hire{width:100%;min-height:46px;border:2px solid #ac5e2b;border-radius:11px;background:#e47a33;color:white;font-size:13px;font-weight:850;margin-top:9px}.hire{background:#5c9c56;border-color:#387639}.preview{display:block;color:#805f37;font-size:11px;margin-top:5px}.offline-sheet{text-align:center;padding-top:24px}.offline-icon{font-size:40px}.offline-sheet h2{margin:6px 0}.offline-sheet p{font-size:13px}.offline-sheet strong{display:block;font-size:29px;color:#9a601d;margin:12px}.offline-sheet .buy{margin-top:14px}@keyframes travel{0%{opacity:0;left:20%}15%{opacity:1}85%{opacity:1}100%{opacity:0;left:72%}}@keyframes burst{0%{opacity:1;transform:translateY(18px)}75%{opacity:1}100%{opacity:0;transform:translateY(-45px)}}@media(max-height:650px){.header{min-height:57px;padding-top:6px}.header h1{font-size:20px}.objective{min-height:32px;margin-bottom:4px}.flow{padding-top:19px;padding-bottom:38px}.route{height:15px}.building{height:42px;width:44px}.goat{font-size:28px}.manual{min-height:39px}.station{padding:2px 5px}.station-info strong{font-size:14px}.station-info small{font-size:9px}.tabs{min-height:56px}}@media(max-width:355px){.station-dairy{margin-left:9px}.station-grill{margin-right:5px}.manual{min-width:70px;font-size:11px}}@media(prefers-reduced-motion:reduce){.cargo.travel,.burst.fly{animation:none}}
</style>
