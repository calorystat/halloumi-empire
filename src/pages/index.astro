---
const base = import.meta.env.BASE_URL;
const halloumi = `${base}icons/halloumi.svg`;
const grill = `${base}icons/grill.svg`;
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#68bdc3"/><meta name="description" content="Halloumi Empire, un jeu de gestion idle."/><title>Halloumi Empire · Idle Tycoon</title></head><body>
<main class="game">
  <header class="hud"><div class="avatar" aria-label="Empire">🐐</div><div class="brand"><span>HALLOUMI</span><strong>EMPIRE</strong></div><div class="money"><span class="goldcoin">●</span><b id="coins">0</b></div></header>
  <section id="screen-island" class="screen island" aria-label="Vue de ton empire">
    <div class="world"><div class="sea"></div><div class="shore"></div><div class="promenade"></div><div class="palm palm-left"><i></i></div><div class="palm palm-right"><i></i></div>
      <div class="world-title"><span>🏝️ CHYPRE · ÎLE 01</span><strong>Ma fromagerie</strong></div>
      <div class="floor"><div class="wall wall-back"></div><div class="wall wall-left"></div><div class="wall wall-right"></div><div class="floor-grid"></div><div class="welcome-sign">HALLOUMI<br/>MARKET</div>
        <div class="decor decor-one">🌿</div><div class="decor decor-two">🌿</div>
        <article class="zone zone-farm" data-open="farm" role="button" tabindex="0" aria-label="Ouvrir Ferme : recruter et améliorer"><div class="zone-halo"></div><div class="stall"><div class="awning"></div><div class="stall-front"></div><div class="stall-content"><span class="goat">🐐</span><span class="milk-props">🥛🥛</span></div></div><span class="worker" id="farm-worker" hidden>👩‍🌾</span><div class="zone-badge"><b>FERME</b><small id="farm-level">Niv. 1</small><span class="chevron">›</span></div></article>
        <div class="delivery delivery-one"><span id="milk-cargo">🥛</span></div>
        <article class="zone zone-dairy" data-open="dairy" role="button" tabindex="0" aria-label="Ouvrir Atelier : recruter et améliorer"><div class="zone-halo"></div><div class="stall"><div class="awning"></div><div class="stall-front"></div><div class="stall-content"><img src={halloumi} alt="Bloc de halloumi"/><span class="pile">▰▰▰</span></div></div><span class="worker" id="dairy-worker" hidden>👨‍🍳</span><div class="zone-badge"><b>ATELIER</b><small id="dairy-level">Niv. 1</small><span class="chevron">›</span></div></article>
        <div class="delivery delivery-two"><img id="halloumi-cargo" src={halloumi} alt=""/></div>
        <article class="zone zone-grill" data-open="grill" role="button" tabindex="0" aria-label="Ouvrir Grill : recruter et améliorer"><div class="zone-halo"></div><div class="stall"><div class="awning"></div><div class="stall-front"></div><div class="stall-content"><img src={grill} alt="Grill à halloumi"/><span class="flames">♨</span></div></div><span class="worker" id="grill-worker" hidden>🧑‍🍳</span><div class="zone-badge"><b>GRILL</b><small id="grill-level">Niv. 1</small><span class="chevron">›</span></div></article>
        <div class="customer customer-one"><i></i><b></b></div><div class="customer customer-two"><i></i><b></b></div><div class="customer customer-three"><i></i><b></b></div><div class="customer customer-four"><i></i><b></b></div><div class="entry">ENTRÉE ↑</div>
      </div>
      <div class="scene-toast" id="burst" aria-hidden="true"></div>
    </div>
    <div class="mission"><span>⭐ MISSION</span><strong id="objective">Vends ton premier halloumi !</strong></div>
    <div class="controls"><button class="produce" data-manual="farm"><span class="control-icon">🐐</span><b>TRAIRE</b><small id="farm-quick">+1 lait</small></button><button class="produce" data-manual="dairy"><img src={halloumi} alt=""/><b>FABRIQUER</b><small id="dairy-quick">1 lait</small></button><button class="produce" data-manual="grill"><img src={grill} alt=""/><b>VENDRE</b><small id="grill-quick">+8 pièces</small></button></div>
    <div class="inventory"><span>🥛 <b id="milk">0</b></span><span><img src={halloumi} alt=""/><b id="halloumi">0</b></span><span>🪙 <b id="income">0/min</b></span></div>
  </section>
  <section id="screen-achievements" class="screen list-screen" hidden><div class="list-head"><span>🏆</span><div><h2>Exploits</h2><p>Fais grandir ton empire.</p></div></div><div id="milestones"></div></section>
  <section id="screen-empire" class="screen list-screen" hidden><div class="list-head"><span>📊</span><div><h2>Empire</h2><p>Surveille ta production.</p></div></div><div id="bottleneck" class="advice"></div><div class="stat"><span>Blocs vendus</span><b id="sold">0</b></div><div class="stat"><span>Prix par bloc</span><b id="price">8</b></div><div class="stat"><span>Actions manuelles</span><b id="taps">0</b></div><p>Partie sauvegardée sur cet appareil. Gains hors ligne limités à quatre heures.</p><button id="reset">Recommencer la partie</button></section>
  <div class="notice" id="toast" hidden role="status" aria-live="polite"></div>
  <nav class="nav"><button data-tab="achievements"><span>★</span>EXPLOITS</button><button data-tab="island" class="selected" aria-current="page"><span>⌂</span>ÎLE</button><button data-tab="empire"><span>▣</span>EMPIRE</button></nav>
  <div class="overlay" id="station-overlay" hidden><button class="scrim" id="close-scrim" aria-label="Fermer"></button><section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title"><div class="sheet-top"><div><small>GÉRER LE BÂTIMENT</small><h2 id="sheet-title">Ferme</h2></div><button id="close-sheet" aria-label="Fermer">✕</button></div><p id="sheet-status"></p><div class="sheet-row"><span>Niveau</span><b id="sheet-level">1</b></div><div class="sheet-row"><span>Rendement</span><b id="sheet-output">1 par cycle</b></div><button class="buy" id="upgrade">Améliorer</button><small id="upgrade-preview"></small><button class="hire" id="automate">Recruter un employé</button></section></div>
  <div class="overlay" id="offline-overlay" hidden><div class="scrim"></div><section class="sheet offline" role="dialog" aria-modal="true" aria-labelledby="offline-title"><div>💰</div><h2 id="offline-title">Ton empire a travaillé !</h2><p id="offline-detail"></p><strong id="offline-coins">+0 pièces</strong><button class="buy" id="collect">Encaisser</button></section></div>
  <span id="screen-title" hidden>Mon île</span>
</main><script>import '../scripts/game.js';</script></body></html>
<style>
:global(*){box-sizing:border-box;-webkit-tap-highlight-color:transparent}:global([hidden]){display:none!important}:global(html){touch-action:manipulation}:global(body){margin:0;background:#203a49;font-family:system-ui,-apple-system,sans-serif;color:#402c29;overscroll-behavior:none}:global(button){font:inherit;cursor:pointer;touch-action:manipulation}:global(button:disabled){opacity:.5;cursor:not-allowed}:global(button:focus-visible),:global([role=button]:focus-visible){outline:3px solid #fff;outline-offset:2px}.game{position:relative;width:min(100%,550px);height:100vh;height:100dvh;min-height:520px;margin:auto;display:flex;flex-direction:column;overflow:hidden;background:#75c7b5}.hud{height:72px;flex:none;z-index:5;display:flex;align-items:center;padding:9px 14px;gap:8px;background:linear-gradient(180deg,#2a4451,#30495b);box-shadow:0 4px 10px #15262c70;color:#fff}.avatar{width:45px;height:45px;display:grid;place-items:center;border-radius:13px;border:2px solid #ffe6a1;background:#be794d;font-size:27px}.brand{flex:1;line-height:1}.brand span{display:block;color:#ffda6e;font-size:10px;font-weight:900;letter-spacing:.1em}.brand strong{font-size:20px;letter-spacing:-.05em}.money{display:flex;align-items:center;gap:5px;min-width:85px;justify-content:center;border-radius:22px;border:2px solid #8b723d;background:#1e3038;padding:6px;color:#fff;font-size:14px}.goldcoin{color:#ffdc52;font-size:20px;text-shadow:1px 1px #b88322}.screen{flex:1;min-height:0}.island{display:flex;flex-direction:column;min-height:0}.world{position:relative;flex:1;min-height:0;overflow:hidden;background:linear-gradient(125deg,#a7dc84 5%,#70b96e 65%,#398e78 100%)}.sea{position:absolute;width:80%;height:45%;right:-31%;top:-18%;background:#68bddd;border:10px solid #f3e6b3;border-radius:45%;box-shadow:0 4px #57a6bd}.shore{position:absolute;right:-20%;top:18%;width:55%;height:20px;background:#ecd398;transform:rotate(-25deg)}.promenade{position:absolute;bottom:-8%;left:-28%;width:150%;height:25%;background:repeating-linear-gradient(90deg,#b6ae9c 0 20px,#d0c4a9 20px 42px);transform:rotate(-13deg);border-top:9px solid #837d6d}.world-title{position:absolute;top:10px;left:13px;z-index:3;background:#2e4951eb;border:2px solid #e1b866;border-radius:12px;padding:7px 11px;color:#fff;box-shadow:0 4px #18313a}.world-title span{display:block;color:#f9db93;font-size:9px;font-weight:900}.world-title strong{font-size:14px}.palm{position:absolute;width:10px;height:40px;background:#9b673a;border-radius:10px;z-index:2;box-shadow:3px 3px #447c5544}.palm i{position:absolute;top:-15px;left:-17px;width:46px;height:30px;background:#438e58;clip-path:polygon(50% 50%,0 0,42% 32%,10% 90%,50% 58%,100% 0,68% 51%,97% 93%)}.palm-left{left:5%;top:24%}.palm-right{right:5%;bottom:20%}.floor{position:absolute;inset:14% 7% 9%;background:#efdfb8;border:8px solid #937355;box-shadow:12px 17px 0 #645849,19px 25px 13px #264a3f8a;transform:skewY(-9deg);border-radius:7px;overflow:hidden}.floor-grid{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 32px,#c7b99d88 33px 34px),repeating-linear-gradient(0deg,transparent 0 32px,#c7b99d88 33px 34px);opacity:.7}.wall{position:absolute;z-index:2;background:#f8e9cb}.wall-back{top:0;left:0;right:0;height:15px;border-bottom:4px solid #bda985}.wall-left{top:0;bottom:0;left:0;width:12px;border-right:4px solid #bda985}.wall-right{top:0;bottom:0;right:0;width:9px;border-left:3px solid #bda985}.welcome-sign{position:absolute;z-index:5;right:2%;top:2%;background:#ce724f;color:#fff8d9;padding:4px;font-size:8px;font-weight:950;text-align:center;border-radius:3px}.decor{position:absolute;z-index:3;font-size:18px}.decor-one{top:48%;left:4%}.decor-two{bottom:19%;right:3%}.zone{position:absolute;z-index:4;width:38%;height:29%;cursor:pointer;transform:skewY(9deg);touch-action:manipulation}.zone-farm{top:10%;left:8%}.zone-dairy{top:38%;right:8%}.zone-grill{bottom:9%;left:12%}.zone-halo{position:absolute;inset:7% 0 0;border-radius:20px;background:#ffc94777;transform:skewY(-9deg);box-shadow:0 0 0 2px #fff3b1a0;animation:halo 2.5s ease-in-out infinite}.stall{position:absolute;inset:13% 12% 16%;background:#f9d598;border:3px solid #9d6142;border-radius:6px;box-shadow:7px 9px 0 #966044,8px 10px 8px #3b4d3866}.stall .awning{position:absolute;top:-17px;left:-5%;width:110%;height:20px;background:repeating-linear-gradient(90deg,#da6752 0 18%,#fff4d5 18% 36%);clip-path:polygon(12% 0,88% 0,100% 100%,0 100%);border:2px solid #ad6041}.dairy-card .awning{background:repeating-linear-gradient(90deg,#5a97b6 0 18%,#fff4d5 18% 36%)}.zone-dairy .awning{background:repeating-linear-gradient(90deg,#5a97b6 0 18%,#fff4d5 18% 36%)}.zone-grill .awning{background:repeating-linear-gradient(90deg,#e59e3f 0 18%,#fff4d5 18% 36%)}.stall-front{position:absolute;left:0;right:0;bottom:0;height:20%;background:#bd8052;border-top:4px solid #865542}.stall-content{position:absolute;inset:4%;display:flex;align-items:center;justify-content:center;gap:2px}.stall-content img{width:42%;max-height:75%;object-fit:contain}.goat{font-size:clamp(27px,7vw,44px)}.milk-props{font-size:clamp(12px,3vw,20px)}.pile{font-size:13px;letter-spacing:-6px;color:#e6b464}.flames{color:#e75728;font-size:23px;font-weight:900}.zone-badge{position:absolute;bottom:-17px;left:3%;right:3%;min-height:26px;padding:4px 15px 4px 7px;border:2px solid #f0e2ab;border-radius:9px;background:#3e6a62;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:3px;box-shadow:0 3px #235049}.zone-badge b{font-size:9px}.zone-badge small{font-size:9px;color:#ffe3a4}.zone-badge .chevron{position:absolute;right:3px;font-size:16px;line-height:1}.worker{position:absolute;right:-3px;top:-9px;font-size:19px;background:#fff2cf;border:2px solid #5b9d6f;border-radius:50%;padding:2px}.delivery{position:absolute;z-index:4;font-size:19px}.delivery-one{left:42%;top:37%}.delivery-two{right:29%;top:71%}.delivery img{width:29px;height:29px}.delivery span,.delivery img{opacity:0;display:inline-block}.delivery .travel{animation:deliver 1s ease-out}.customer{position:absolute;z-index:3;width:13px;height:28px;filter:drop-shadow(3px 5px 2px #543e3577);animation:customers 2s ease-in-out infinite alternate}.customer i{display:block;width:12px;height:12px;border-radius:50%;background:#e7af83;border:2px solid #674c39}.customer b{display:block;width:14px;height:17px;border-radius:7px 7px 3px 3px;background:#ad6dc8}.customer-one{top:34%;left:50%}.customer-two{bottom:26%;right:36%;animation-delay:-.7s}.customer-two b{background:#6babc5}.customer-three{bottom:22%;left:46%;animation-delay:-1.1s}.customer-three b{background:#d26a61}.customer-four{top:26%;right:19%;animation-delay:-1.6s}.customer-four b{background:#80af5a}.entry{position:absolute;bottom:1%;right:16%;background:#516f7b;color:white;font-size:8px;font-weight:900;padding:3px}.scene-toast{position:absolute;z-index:7;top:45%;left:50%;color:#fff9cc;font-weight:950;font-size:21px;text-shadow:2px 2px #4d3223;opacity:0;pointer-events:none}.scene-toast.fly{animation:pop 1s ease-out}.mission{flex:none;margin:6px 10px 2px;border:2px solid #dfad64;border-radius:11px;background:#fff6d5;padding:7px 9px;display:flex;align-items:center;gap:8px;min-height:36px}.mission span{color:#ad6a25;font-size:10px;font-weight:900;white-space:nowrap}.mission strong{font-size:11px}.controls{flex:none;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:5px 10px}.produce{border:2px solid #b98452;border-radius:12px;background:linear-gradient(#fff4d8,#f5d698);min-height:56px;box-shadow:0 3px #b07c49;display:grid;grid-template-columns:29px 1fr;grid-template-rows:1fr 1fr;text-align:left;align-items:center;padding:4px;color:#6e421f}.produce:active{transform:translateY(2px);box-shadow:0 1px #b07c49}.produce span,.produce img{grid-row:1/3;font-size:24px;width:27px;height:27px;object-fit:contain}.produce b{font-size:10px}.produce small{font-size:9px}.inventory{flex:none;display:flex;justify-content:space-around;align-items:center;margin:0 10px 4px;height:27px;border-radius:9px;background:#31575a;color:#fff;font-size:11px}.inventory span{display:flex;align-items:center;gap:3px}.inventory img{width:19px;height:19px}.inventory b,.money b{font-variant-numeric:tabular-nums}.nav{z-index:8;flex:none;display:grid;grid-template-columns:repeat(3,1fr);height:66px;padding:4px 5px max(7px,env(safe-area-inset-bottom));background:#f9f4e8;box-shadow:0 -4px 12px #34526988}.nav button{border:0;border-radius:12px;background:transparent;color:#907c67;font-weight:900;font-size:9px}.nav button span{display:block;font-size:23px;line-height:1.2}.nav button.selected{background:#e9c98f;color:#774424}.notice{position:absolute;top:79px;left:20px;right:20px;z-index:12;padding:11px;text-align:center;background:#e4f6d6;border:2px solid #95c97b;border-radius:10px;font-size:12px;font-weight:850}.list-screen{padding:14px;overflow-y:auto;background:#fff0d4}.list-head{display:flex;align-items:center;gap:12px;background:#fff9eb;border:2px solid #e4bb76;border-radius:12px;padding:12px}.list-head>span{font-size:32px}.list-head h2{margin:0}.list-head p{font-size:12px;margin:2px}.achievement,.advice,.stat{background:#fffaf0;border:2px solid #d9b57d;border-radius:12px;margin:12px 0;padding:13px;font-size:13px;font-weight:750}.achievement.complete{background:#e1f2d6;border-color:#99c879}.stat{display:flex;justify-content:space-between}.list-screen>p{font-size:12px}.list-screen #reset{padding:9px;border-radius:8px;background:#ffe4ce;border:1px solid #b87356;color:#8b4329}.overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:flex-end}.scrim{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:0;background:#1c2732a9}.sheet{position:relative;width:100%;padding:16px 19px max(22px,env(safe-area-inset-bottom));background:#fff3d5;border:3px solid #d4a066;border-bottom:0;border-radius:21px 21px 0 0;box-shadow:0 -6px 25px #13262b66}.sheet-top{display:flex;justify-content:space-between}.sheet-top small{font-size:10px;font-weight:950;color:#a16d32}.sheet-top h2{margin:2px 0;font-size:23px}.sheet-top button{border:0;background:#f0dfbf;border-radius:8px;padding:6px 11px}.sheet p{font-size:12px}.sheet-row{display:flex;justify-content:space-between;padding:9px;background:#f9e5b9;border-radius:8px;margin:6px 0;font-size:13px}.sheet .buy,.sheet .hire{width:100%;min-height:45px;border-radius:10px;border:2px solid #a75928;background:#e17e37;color:#fff;font-weight:850;margin-top:9px}.sheet .hire{background:#55a073;border-color:#32845b}.sheet>small{display:block;margin-top:5px;font-size:11px}.offline{text-align:center}.offline>div{font-size:37px}.offline h2{margin:4px}.offline strong{display:block;color:#a27029;font-size:28px}@keyframes halo{50%{opacity:.35;transform:scale(1.04) skewY(-9deg)}}@keyframes customers{to{transform:translate(8px,-7px)}}@keyframes deliver{0%{opacity:0;transform:translate(-22px,11px)}25%{opacity:1}80%{opacity:1}100%{opacity:0;transform:translate(19px,-9px)}}@keyframes pop{0%{opacity:1;transform:translateY(12px)}75%{opacity:1}100%{opacity:0;transform:translateY(-47px)}}@media(max-height:680px){.hud{height:57px}.world-title{top:6px;padding:4px 6px}.floor{inset:12% 8% 7%}.mission{min-height:28px;padding:3px 7px}.controls{margin:3px 10px}.produce{min-height:48px}.nav{height:55px}.zone-badge{min-height:22px;bottom:-12px}}@media(max-width:370px){.zone{width:42%}.zone-farm{left:3%}.zone-dairy{right:3%}.zone-grill{left:6%}.building-art{width:46px}.zone-badge b{font-size:8px}.produce{grid-template-columns:24px 1fr;padding:3px}.produce span,.produce img{width:22px;height:22px;font-size:21px}.produce b{font-size:9px}}@media(prefers-reduced-motion:reduce){.zone-halo,.customer,.delivery .travel,.scene-toast.fly{animation:none}}
</style>
